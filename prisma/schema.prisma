// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id            Int           @id @default(autoincrement())
  tipoCliente   TipoCliente
  nombre        String
  apellido      String
  celular       String        @unique
  email         String?       @unique
  direcciones   Direccion[]
  transacciones Transaccion[]
  fidelidades   Fidelidad[]
  resenas       Resena[] // reseñas que deja el cliente

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TipoCliente {
  mayorista
  detal
}

model Direccion {
  id           Int     @id @default(autoincrement())
  clienteId    Int
  cliente      Cliente @relation(fields: [clienteId], references: [id])
  urbanizacion String
  direccion    String
  tipo         String

  createdAt DateTime @default(now())
}

model Producto {
  id              Int             @id @default(autoincrement())
  nombre          String
  precioDetal     Float
  precioMayorista Float
  categoria       String
  descripcion     String?
  tipoCliente     TipoCliente     @default(detal)
  inventario      Int
  ubicacion       String?
  imagenes        Imagen[]
  detalles        DetalleCompra[]
  resenas         Resena[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Imagen {
  id         Int      @id @default(autoincrement())
  url        String // URL de Cloudinary, S3, etc.
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Transaccion {
  id           Int               @id @default(autoincrement())
  numeroOrden  String            @unique
  clienteId    Int
  cliente      Cliente           @relation(fields: [clienteId], references: [id])
  fechaCompra  DateTime          @default(now())
  montoTotal   Float
  estado       EstadoTransaccion
  tipodeRetiro TipoRetiro        @default(envio)
  detalles     DetalleCompra[]
  fidelidades  Fidelidad[]
  pagos        Pago[]
  resenas      Resena[]

  createdAt DateTime @default(now())
}

enum EstadoTransaccion {
  pagado
  pendiente
  cancelado
}

enum TipoRetiro {
  envio
  recogida
}

model DetalleCompra {
  id             Int   @id @default(autoincrement())
  transaccionId  Int
  productoId     Int
  cantidad       Int
  precioUnitario Float

  transaccion Transaccion @relation(fields: [transaccionId], references: [id])
  producto    Producto    @relation(fields: [productoId], references: [id])
}

model Fidelidad {
  id             Int            @id @default(autoincrement())
  clienteId      Int
  cliente        Cliente        @relation(fields: [clienteId], references: [id])
  transaccionId  Int?
  transaccion    Transaccion?   @relation(fields: [transaccionId], references: [id])
  fecha          DateTime       @default(now())
  tipoMovimiento TipoMovimiento
  puntos         Int
}

enum TipoMovimiento {
  acumulacion
  redencion
}

model Pago {
  id            Int         @id @default(autoincrement())
  transaccionId Int
  transaccion   Transaccion @relation(fields: [transaccionId], references: [id])

  montoBs    Float? // monto en bolívares
  montoUsd   Float? // monto en dólares
  tasaCambio Float? // tasa usada en la transacción

  metodoPago MetodoPago
  referencia String? // número de referencia (si aplica)
  fechaPago  DateTime? // fecha del pago (si aplica)

  createdAt DateTime @default(now())
}

enum MetodoPago {
  TransferenciaBs
  EfectivoUsd
  Zelle
  PagoMovil
  TransferenciaUsd
}

model Resena {
  id            Int      @id @default(autoincrement())
  clienteId     Int
  productoId    Int
  transaccionId Int // reseña ligada a una transacción específica
  estrellas     Int // de 1 a 5
  comentario    String? // texto opcional
  fecha         DateTime @default(now())

  cliente     Cliente     @relation(fields: [clienteId], references: [id])
  producto    Producto    @relation(fields: [productoId], references: [id])
  transaccion Transaccion @relation(fields: [transaccionId], references: [id])

  @@index([clienteId, productoId, transaccionId])
}
