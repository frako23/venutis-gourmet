// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id               Int                @id @default(autoincrement())
  tipoCliente      TipoCliente
  nombre           String
  apellido         String
  rif              String?            @unique
  nombreBusqueda   String
  celular          String?            @unique
  email            String?            @unique
  direcciones      Direccion[]
  transacciones    Transaccion[]
  notasEntrega     NotaEntrega[]
  fidelidades      Fidelidad[]
  resenas          Resena[] // reseñas que deja el cliente
  historialCliente HistorialCliente[]
  equivalencias    EquivalenciaCliente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TipoCliente {
  mayorista
  detal
}

enum AccionHistorialCliente {
  creado
  actualizado
}

model HistorialCliente {
  id                Int                    @id @default(autoincrement())
  clienteId         Int
  actorId           String?
  actorEmail        String?
  accion            AccionHistorialCliente
  camposModificados String[]
  createdAt         DateTime               @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId, createdAt])
}

model Direccion {
  id           Int     @id @default(autoincrement())
  clienteId    Int
  cliente      Cliente @relation(fields: [clienteId], references: [id])
  urbanizacion String
  direccion    String
  tipo         String

  createdAt DateTime @default(now())
}

model Producto {
  id              Int                  @id @default(autoincrement())
  nombre          String
  precioDetal     Float                @default(0.0)
  precioMayorista Float                @default(0.0)
  categoria       String
  descripcion     String?
  inventario      Float                @default(0)
  ubicacion       String?
  // Posición en el catálogo (menor = antes); null = sin posición, va al final.
  orden           Int?
  imagenes        Imagen[]
  detalles        DetalleCompra[]
  detallesNotas   DetalleNotaEntrega[]
  resenas         Resena[]
  equivalencias   EquivalenciaProducto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Imagen {
  id         Int      @id @default(autoincrement())
  url        String
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Transaccion {
  id               Int                          @id @default(autoincrement())
  numeroOrden      String                       @unique
  clienteId        Int
  cliente          Cliente                      @relation(fields: [clienteId], references: [id])
  fechaCompra      DateTime                     @default(now())
  montoTotal       Float
  montoSubtotal    Float                        @default(0)
  montoDelivery    Float                        @default(0)
  tipoDescuento    TipoDescuento?
  valorDescuento   Float?
  montoDescuento   Float                        @default(0)
  tasaCambio       Float?
  estado           EstadoTransaccion
  tipodeRetiro     TipoRetiro                   @default(envio)
  zonaEntrega      String?
  aliasEntrega     String?
  direccionEntrega String?
  claveIdempotencia String?                     @unique
  importada        Boolean                      @default(false)
  detalles         DetalleCompra[]
  fidelidades      Fidelidad[]
  pagos            Pago[]
  resenas          Resena[]
  historialEstados EstadoTransaccionHistorial[]
  notasEntrega     NotaEntrega[]

  createdAt DateTime @default(now())

  @@index([fechaCompra, estado])
  @@index([clienteId, fechaCompra])
}

enum EstadoTransaccion {
  pagado
  pendiente
  por_cobrar
  en_pedido
  cancelado
}

enum TipoDescuento {
  porcentaje
  usd
}

model EstadoTransaccionHistorial {
  id             Int                @id @default(autoincrement())
  transaccionId  Int
  estadoAnterior EstadoTransaccion?
  estadoNuevo    EstadoTransaccion
  actorId        String?
  actorEmail     String?
  motivo         String?
  createdAt      DateTime           @default(now())

  transaccion Transaccion @relation(fields: [transaccionId], references: [id], onDelete: Cascade)

  @@index([transaccionId, createdAt])
}

enum TipoPrecio {
  detal
  mayor
  promo
}

enum TipoRetiro {
  envio
  recogida
}

model DetalleCompra {
  id             Int   @id @default(autoincrement())
  transaccionId  Int
  productoId     Int
  cantidad       Float
  precioUnitario Float
  tipoPrecio     TipoPrecio?

  transaccion Transaccion @relation(fields: [transaccionId], references: [id])
  producto    Producto    @relation(fields: [productoId], references: [id])

  @@index([productoId, transaccionId])
}

model NotaEntrega {
  id               Int      @id @default(autoincrement())
  numeroNota       String   @unique
  clienteId        Int
  transaccionId    Int?
  fechaEntrega     DateTime @default(now())
  direccionEntrega String?
  personaRecibe    String?
  observaciones    String?
  creadoPorId      String?
  creadoPorEmail   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cliente     Cliente              @relation(fields: [clienteId], references: [id])
  transaccion Transaccion?         @relation(fields: [transaccionId], references: [id])
  detalles    DetalleNotaEntrega[]

  @@index([clienteId, fechaEntrega])
  @@index([transaccionId])
}

model DetalleNotaEntrega {
  id                Int    @id @default(autoincrement())
  notaEntregaId     Int
  productoId        Int?
  productoNombre    String
  cantidad          Int
  precioUnitarioUsd Float?
  subtotalUsd       Float?

  notaEntrega NotaEntrega @relation(fields: [notaEntregaId], references: [id], onDelete: Cascade)
  producto    Producto?   @relation(fields: [productoId], references: [id], onDelete: SetNull)

  @@index([notaEntregaId])
  @@index([productoId])
}

model Fidelidad {
  id             Int            @id @default(autoincrement())
  clienteId      Int
  cliente        Cliente        @relation(fields: [clienteId], references: [id])
  transaccionId  Int?
  transaccion    Transaccion?   @relation(fields: [transaccionId], references: [id])
  fecha          DateTime       @default(now())
  tipoMovimiento TipoMovimiento
  puntos         Int
}

enum TipoMovimiento {
  acumulacion
  redencion
}

model Pago {
  id            Int         @id @default(autoincrement())
  transaccionId Int
  transaccion   Transaccion @relation(fields: [transaccionId], references: [id])

  montoBs    Float? // monto en bolívares
  montoUsd   Float? // monto en dólares
  tasaCambio Float? // tasa usada en la transacción

  metodoPago MetodoPago
  referencia String? // número de referencia (si aplica)
  fechaPago  DateTime? // fecha del pago (si aplica)

  esAbono    Boolean   @default(false) // cobro recibido (false = pago declarado)
  actorId    String?
  actorEmail String?
  anuladoEn  DateTime?

  createdAt DateTime @default(now())
}

enum MetodoPago {
  TransferenciaBs
  EfectivoUsd
  Zelle
  PagoMovil
  TransferenciaUsd
  NoEspecificado
}

model Resena {
  id            Int      @id @default(autoincrement())
  clienteId     Int
  productoId    Int
  transaccionId Int // reseña ligada a una transacción específica
  estrellas     Int // de 1 a 5
  comentario    String? // texto opcional
  fecha         DateTime @default(now())

  cliente     Cliente     @relation(fields: [clienteId], references: [id])
  producto    Producto    @relation(fields: [productoId], references: [id])
  transaccion Transaccion @relation(fields: [transaccionId], references: [id])

  @@index([clienteId, productoId, transaccionId])
}

model EquivalenciaProducto {
  id         Int      @id @default(autoincrement())
  clave      String   @unique
  productoId Int
  grupo      String?
  producto   String
  sabor      String?
  gramos     Int?
  actorEmail String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  productoRef Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId])
}

model EquivalenciaCliente {
  id         Int      @id @default(autoincrement())
  clave      String   @unique
  clienteId  Int
  actorEmail String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}
